# Agent Detective environment configuration (see build spec section 7).
# Copy to .env for local development. docker-compose works without .env;
# values from .env override the compose defaults where referenced.

# Core infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_detective
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379/0

# MinIO payload store (overflow payloads, keys payloads/{graph_id}/{run_id}/{input|output})
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-detective-payloads
MINIO_SECURE=false

# Service ports
INGEST_PORT=8001
API_PORT=8000
WEB_PORT=5173

# Blame engine tuning
BLAME_THRESHOLD=0.5
GAP_THRESHOLD=0.25
MIN_DROP=0.10
# Cumulative degradation: total decline over >= CUM_MIN_EDGES consecutive
# dropping edges (each step >= CUM_STEP_MIN) that counts as an origin even
# when no single edge crosses GAP_THRESHOLD.
CUM_DROP_THRESHOLD=0.30
CUM_MIN_EDGES=2
CUM_STEP_MIN=0.05

# Composite score weights and minimum-weight floor
SCORE_W_SCHEMA=0.35
SCORE_W_JUDGE=0.40
SCORE_W_HEURISTICS=0.15
SCORE_MIN_WEIGHT=0.5

# Worker pipeline
TIER2_SAMPLE_PCT=0
MAX_LOOP_ITERATIONS=10
GRAPH_QUIESCENCE_SECONDS=30
PAYLOAD_INLINE_MAX_KB=64
COST_BUDGET_DEFAULT_USD=

# Feature flags
# A2A_MESSAGE edge detection. Must stay on for ingest: the demo pipeline's
# retry loop (compliance -> scraper retry -> compliance) closes its cycle via
# an A2A_MESSAGE edge, and peer-to-peer architectures need it to link runs
# across traces. Setting false here overrides the compose ingest default (true)
# and degrades A2A traffic to membership-without-edges.
A2A_DETECTION=true

# Judge LLM client — any OpenAI-compatible /v1 endpoint. Pick one:
#   OpenAI:      JUDGE_BASE_URL=https://api.openai.com/v1      JUDGE_MODEL=gpt-4o-mini          JUDGE_API_KEY=sk-...
#   OpenRouter:  JUDGE_BASE_URL=https://openrouter.ai/api/v1   JUDGE_MODEL=openai/gpt-4o-mini   JUDGE_API_KEY=sk-or-...
#   Ollama:      JUDGE_BASE_URL=http://localhost:11434/v1      JUDGE_MODEL=llama3.1:8b          (no key)
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=
JUDGE_MODEL=llama3.1:8b
JUDGE_TIMEOUT_S=30
JUDGE_CONCURRENCY=4
# Optional determinism seed forwarded to /chat/completions (empty = unset)
JUDGE_SEED=

# Alerting (empty = log to console instead of Slack)
SLACK_WEBHOOK_URL=
