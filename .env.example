# Agent Detective environment configuration (see build spec section 7).
# Copy to .env for local development. docker-compose works without .env;
# values from .env override the compose defaults where referenced.

# Core infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_detective
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379/0

# MinIO payload store (overflow payloads, keys payloads/{graph_id}/{run_id}/{input|output})
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-detective-payloads
MINIO_SECURE=false

# Service ports
INGEST_PORT=8001
API_PORT=8000
WEB_PORT=5173

# Blame engine tuning
BLAME_THRESHOLD=0.5
GAP_THRESHOLD=0.25
MIN_DROP=0.10

# Composite score weights and minimum-weight floor
SCORE_W_SCHEMA=0.35
SCORE_W_JUDGE=0.40
SCORE_W_HEURISTICS=0.15
SCORE_MIN_WEIGHT=0.5

# Worker pipeline
TIER2_SAMPLE_PCT=0
MAX_LOOP_ITERATIONS=10
GRAPH_QUIESCENCE_SECONDS=30
PAYLOAD_INLINE_MAX_KB=64
COST_BUDGET_DEFAULT_USD=

# Feature flags
A2A_DETECTION=false

# Judge LLM client (OpenAI-compatible chat completions endpoint)
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=
JUDGE_MODEL=llama3.1:8b
JUDGE_TIMEOUT_S=30
JUDGE_CONCURRENCY=4

# Alerting (empty = log to console instead of Slack)
SLACK_WEBHOOK_URL=
